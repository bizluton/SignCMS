# SignCMS Edge Function Secrets
# Set via: supabase secrets set --env-file supabase/functions/.env
# (copy this file to .env and fill in the values)

# ── MQTT Broker ───────────────────────────────────────────────────────────────
# Broker: rcc.signcms.net:18883  (TCP MQTT over TLS)
#
# MQTT_BROKER_WS      → returned to player devices in the player-sync response
#                       Android Paho auto-converts mqtts:// → ssl:// internally
#
# MQTT_BROKER_WS_SERVER → used by Edge Functions to publish commands / shadows
#                         (defaults to MQTT_BROKER_WS if this var is not set)
#
MQTT_BROKER_WS=mqtts://rcc.signcms.net:18883
MQTT_BROKER_WS_SERVER=mqtts://rcc.signcms.net:18883

# Mosquitto server account (configured in mosquitto-go-auth backend)
# This user must have publish access to all signage/player/# topics
MQTT_SERVER_USER=signcms-server
MQTT_SERVER_PASS=CHANGE_ME

# ── Supabase (auto-injected in Edge Functions, shown here for reference) ──────
# SUPABASE_URL=https://narhbpojjtnalyfiwxue.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
