# 與 CMS 端 TRANSCODE_HMAC_SECRET 完全相同(建議 ≥32 bytes 隨機字串)
HMAC_SECRET=replace-with-shared-secret

# ─── S3 / R2 / MinIO ───
# AWS S3:        https://s3.us-east-1.amazonaws.com   (S3_FORCE_PATH_STYLE=false)
# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com  (S3_FORCE_PATH_STYLE=true)
# MinIO:         https://minio.example.com            (S3_FORCE_PATH_STYLE=true)
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=signcms-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=transcoded/

# 公開存取 base URL(R2 自訂網域 / CloudFront / MinIO public domain)
# 未設定則回傳簽章 endpoint URL(多半 private,CMS 拿不到)
S3_PUBLIC_BASE_URL=https://media.signcms.net

# 上傳完是否刪除本地輸出(預設 true)
DELETE_AFTER_UPLOAD=true
