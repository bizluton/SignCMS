# Copy to .env and fill in values

# Async database URL
# PostgreSQL (production / Supabase):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/signcms
# SQLite (local dev — uncomment and comment out line above):
# DATABASE_URL=sqlite+aiosqlite:///./signcms_media.db

# Where uploaded files are stored on disk
STORAGE_PATH=./storage

# Public base URL — used to build asset download URLs returned in the API
BASE_URL=http://localhost:8000
